{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReceiptCapture": {
    "DataDirectory": "App_Data",
    "MaxUploadBytes": 12582912,
    "Accounting": {
      "Endpoint": "",
      "ApiKeyHeaderName": "X-API-Key",
      "IncludeImage": true
    },
    "Ocr": {
      "ExecutablePath": "tesseract",
      "Languages": "eng+fra",
      "PageSegmentationMode": 6
    }
  }
}
