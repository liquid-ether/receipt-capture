<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:ReceiptCapture.App.Services"
             xmlns:vm="clr-namespace:ReceiptCapture.App.ViewModels"
             x:Class="ReceiptCapture.App.Views.CapturePage"
             x:DataType="vm:CaptureViewModel"
             Title="{loc:Translate App_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="16">

            <Label Text="{loc:Translate Capture_Title}" Style="{StaticResource PageTitle}" />

            <Label Text="{Binding PendingSummary}" Style="{StaticResource Caption}" />

            <Button Text="{loc:Translate Capture_TakePhoto}"
                    Command="{Binding TakePhotoCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <Button Text="{loc:Translate Capture_ChooseFromLibrary}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding PickPhotoCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsBusy}" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotEmpty}}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
