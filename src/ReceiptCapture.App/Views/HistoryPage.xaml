<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:ReceiptCapture.App.Services"
             xmlns:vm="clr-namespace:ReceiptCapture.App.ViewModels"
             x:Class="ReceiptCapture.App.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="{loc:Translate History_Title}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16" RowSpacing="12">

        <Button Grid.Row="0"
                Text="{loc:Translate History_SyncNow}"
                Command="{Binding SyncNowCommand}"
                IsEnabled="{Binding IsNotBusy}" />

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="{Binding StatusMessage}"
                   Style="{StaticResource Caption}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotEmpty}}" />
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotEmpty}}" />
            <Label Text="{loc:Translate History_Empty}"
                   Style="{StaticResource Caption}"
                   IsVisible="{Binding IsEmpty}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="2"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Receipts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReceiptListItem">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Merchant}"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding AmountText}"
                                       FontAttributes="Bold" />

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding DateText}"
                                       Style="{StaticResource Caption}" />

                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       Style="{StaticResource Caption}" />

                                <Label Grid.Row="2" Grid.ColumnSpan="2"
                                       Text="{Binding LastError}"
                                       Style="{StaticResource ErrorLabel}"
                                       IsVisible="{Binding HasError}"
                                       LineBreakMode="WordWrap" />

                                <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="8">
                                    <Button Text="{loc:Translate History_Retry}"
                                            Style="{StaticResource SecondaryButton}"
                                            IsVisible="{Binding CanRetry}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=RetryCommand}"
                                            CommandParameter="{Binding .}" />
                                    <Button Text="{loc:Translate History_Delete}"
                                            Style="{StaticResource DestructiveButton}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=DeleteCommand}"
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
