<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:ReceiptCapture.App.Services"
             xmlns:vm="clr-namespace:ReceiptCapture.App.ViewModels"
             x:Class="ReceiptCapture.App.Views.ReviewPage"
             x:DataType="vm:ReviewViewModel"
             Title="{loc:Translate Review_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="12">

            <!-- Whatever the parser was unsure about, said plainly and up front. -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding HasWarnings}">
                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Warnings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Label Text="{Binding .}" Style="{StaticResource WarningLabel}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Image Source="{Binding ImagePath}"
                   Aspect="AspectFit"
                   HeightRequest="180"
                   IsVisible="{Binding ImagePath, Converter={StaticResource IsNotEmpty}}" />

            <Label Text="{loc:Translate Review_Merchant}" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding MerchantName}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{loc:Translate Review_Date}" Style="{StaticResource FieldLabel}" />
                    <DatePicker Date="{Binding TransactionDate}" IsEnabled="{Binding HasTransactionDate}" />
                </VerticalStackLayout>
                <CheckBox Grid.Column="1"
                          IsChecked="{Binding HasTransactionDate}"
                          VerticalOptions="End" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{loc:Translate Review_Subtotal}" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding SubtotalText}" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="{loc:Translate Review_Tip}" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding TipText}" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="{loc:Translate Review_Taxes}" Style="{StaticResource SectionHeading}" />

            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Taxes}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:TaxLineViewModel">
                        <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" Text="{Binding Code}" />
                            <Entry Grid.Column="1" Text="{Binding AmountText}" Keyboard="Numeric" />
                            <Button Grid.Column="2"
                                    Text="✕"
                                    Style="{StaticResource DestructiveButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ReviewViewModel}}, Path=RemoveTaxCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="{loc:Translate Review_AddTax}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding AddTaxCommand}" />

            <Label Text="{loc:Translate Review_Total}" Style="{StaticResource SectionHeading}" />
            <Entry Text="{Binding TotalText}" Keyboard="Numeric" Style="{StaticResource TotalEntry}" />

            <Label Text="{loc:Translate Review_Currency}" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Currency}" MaxLength="3" />

            <Label Text="{loc:Translate Review_Category}" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding CategoryNames}" SelectedIndex="{Binding SelectedCategoryIndex}" />

            <Label Text="{loc:Translate Review_Notes}" Style="{StaticResource FieldLabel}" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotEmpty}}" />

            <Button Text="{loc:Translate Review_Send}"
                    Command="{Binding SendCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

            <Button Text="{loc:Translate Review_Discard}"
                    Style="{StaticResource DestructiveButton}"
                    Command="{Binding DiscardCommand}"
                    IsEnabled="{Binding IsNotBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
