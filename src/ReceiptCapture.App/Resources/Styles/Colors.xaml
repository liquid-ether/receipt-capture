<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#1F6F54</Color>
    <Color x:Key="PrimaryDark">#14523E</Color>
    <Color x:Key="Secondary">#5B8C7B</Color>

    <Color x:Key="Danger">#B3261E</Color>
    <Color x:Key="Warning">#8A6100</Color>
    <Color x:Key="Success">#1F6F54</Color>

    <Color x:Key="PageBackgroundLight">#FFFFFF</Color>
    <Color x:Key="PageBackgroundDark">#121212</Color>
    <Color x:Key="CardBackgroundLight">#F4F6F5</Color>
    <Color x:Key="CardBackgroundDark">#1E1F1E</Color>

    <Color x:Key="TextPrimaryLight">#1A1C1B</Color>
    <Color x:Key="TextPrimaryDark">#E6E1E5</Color>
    <Color x:Key="TextSecondaryLight">#4A4E4C</Color>
    <Color x:Key="TextSecondaryDark">#B0B4B2</Color>

    <Color x:Key="SeparatorLight">#DCE0DE</Color>
    <Color x:Key="SeparatorDark">#333735</Color>

</ResourceDictionary>
