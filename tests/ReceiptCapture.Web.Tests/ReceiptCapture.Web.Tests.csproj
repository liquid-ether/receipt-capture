<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Lets the OCR tests skip, rather than fail, where tesseract is not installed. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      No SQLite bundle here: the web project already brings SQLitePCLRaw.bundle_sqlite3,
      and a second bundle would put a competing SQLitePCLRaw.batteries_v2.dll in the
      same output folder. These tests therefore run against the same system SQLite the
      deployed app uses, which is what we want them to be testing.
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ReceiptCapture.Web\ReceiptCapture.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
